---
import Base from '../layouts/Base.astro';
import { site, prestasi, waLink } from '../data/site';
---
<Base title="Kontak"><div class="mx-auto max-w-5xl px-5 py-12">
<h1 class="text-3xl md:text-4xl font-extrabold text-primary-dark mb-8">Kontak</h1>
<div class="prose-col space-y-4 text-ink">
<p>{site.alamat}</p><p>Telepon: {site.telepon}</p><p>Email: <a class="underline" href={`mailto:${site.email}`}>{site.email}</a></p>
<p><a class="underline" href={site.facebook}>Facebook sekolah</a></p>
<iframe title="Peta lokasi sekolah" class="w-full h-80 rounded border-0" loading="lazy" src={`https://maps.google.com/maps?q=${site.geo.lat},${site.geo.lng}&z=16&output=embed`}></iframe>
</div></div></Base>
