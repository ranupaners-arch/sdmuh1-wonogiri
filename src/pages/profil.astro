---
import Base from '../layouts/Base.astro';
import { site, prestasi, waLink } from '../data/site';
---
<Base title="Profil"><div class="mx-auto max-w-5xl px-5 py-12">
<h1 class="text-3xl md:text-4xl font-extrabold text-primary-dark mb-8">Profil</h1>
<div class="prose-col space-y-4 text-ink">
<p>{site.name} berdiri pada {site.berdiri} dan berada di bawah naungan {site.naungan}.</p>
<table class="w-full text-left text-sm border-t border-black/10"><tbody>
<tr class="border-b border-black/10"><th class="py-2 pr-4 font-medium">NPSN</th><td>{site.npsn}</td></tr>
<tr class="border-b border-black/10"><th class="py-2 pr-4 font-medium">Status</th><td>{site.status}</td></tr>
<tr class="border-b border-black/10"><th class="py-2 pr-4 font-medium">Akreditasi</th><td>{site.akreditasi}</td></tr>
<tr class="border-b border-black/10"><th class="py-2 pr-4 font-medium">Alamat</th><td>{site.alamat}</td></tr>
<tr class="border-b border-black/10"><th class="py-2 pr-4 font-medium">Kepala sekolah</th><td>{site.kepsek}</td></tr></tbody></table>
<p class="text-muted">Sejarah, visi, misi, sambutan, dan struktur organisasi menunggu data dari sekolah.</p>
</div></div></Base>
