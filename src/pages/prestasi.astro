---
import Base from '../layouts/Base.astro';
import { site, prestasi, waLink } from '../data/site';
---
<Base title="Prestasi"><div class="mx-auto max-w-5xl px-5 py-12">
<h1 class="text-3xl md:text-4xl font-extrabold text-primary-dark mb-8">Prestasi</h1>
<div class="prose-col space-y-4 text-ink">
<ul class="space-y-6">{prestasi.map(p => <li class="border-l-4 border-gold pl-4"><p class="font-bold">{p.lomba} ({p.tahun})</p><p class="text-muted">{p.tingkat}. {p.hasil}</p></li>)}</ul>
</div></div></Base>
